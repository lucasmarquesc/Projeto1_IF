@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<div class="container text-center mt-5">
    <div class="card shadow-lg p-4 rounded-4">
        <h1 class="text-danger fw-bold">⚠️ Ocorreu um erro</h1>
        <p class="lead text-muted">Algo inesperado aconteceu ao processar sua solicitação.</p>

        @if (Model.ShowRequestId)
        {
            <p class="mt-3">
                <strong>ID da Requisição:</strong>
                <code class="bg-light p-1 rounded">@Model.RequestId</code>
            </p>
        }

        <hr />

        <h4 class="mt-4">Ambiente de Desenvolvimento</h4>
        <p class="text-muted">
            Ativar o ambiente <strong>Desenvolvimento</strong> exibirá informações detalhadas sobre o erro ocorrido.
        </p>
        <p class="text-warning fw-semibold">
            ⚠️ Atenção: não habilite o ambiente de Desenvolvimento em aplicações publicadas,
            pois informações sensíveis podem ser exibidas para os usuários finais.
        </p>
        <p class="text-muted">
            Para depuração local, defina a variável de ambiente
            <code>ASPNETCORE_ENVIRONMENT</code> como <strong>Development</strong> e reinicie a aplicação.
        </p>

        <a href="/" class="btn btn-primary mt-3 rounded-pill px-4">⬅ Voltar à Página Inicial</a>
    </div>
</div>
