@model Projeto1_IF.Models.TbPaciente

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
        /* Container geral */
    div {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        max-width: 700px;
        margin: 40px auto;
        padding: 20px;
        background-color: #fdfdfd;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    /* Títulos */
    h1 {
        text-align: center;
        color: #c0392b; /* vermelho suave de alerta */
        margin-bottom: 10px;
    }

    h3 {
        text-align: center;
        color: #555;
        font-weight: 400;
        margin-bottom: 25px;
    }

    /* Lista de detalhes (dl) */
    dl.row {
        background-color: #f7f7f7;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 25px;
        box-shadow: inset 0 1px 3px rgba(0,0,0,0.05);
    }

    dt.col-sm-2 {
        font-weight: 600;
        color: #333;
        padding: 5px 0;
    }

    dd.col-sm-10 {
        color: #555;
        padding: 5px 0;
        margin-left: 0;
    }

    /* Botões */
    .btn-danger {
        background-color: #e74c3c;
        border-color: #e74c3c;
        padding: 10px 25px;
        font-size: 16px;
        border-radius: 8px;
        transition: background-color 0.3s ease;
        color: #fff;
        cursor: pointer;
    }

    .btn-danger:hover {
        background-color: #c0392b;
        border-color: #c0392b;
    }

    /* Link "Back to List" */
    a {
        color: #4a90e2;
        text-decoration: none;
        font-weight: 500;
        margin-left: 15px;
    }

    a:hover {
        text-decoration: underline;
    }
    
</script>

